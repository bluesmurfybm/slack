{
  "display_information": {
    "name": "WorkHub AI",
    "description": "유지보수 현황판 리스트 변경을 워커에 전달하는 커스텀 스텝 + 댓글 채널 감시",
    "background_color": "#1f2d3d"
  },
  "features": {
    "bot_user": {
      "display_name": "WorkHub AI",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["lists:read", "channels:history", "chat:write"]
    }
  },
  "functions": {
    "workhub_item_changed": {
      "title": "WorkHub AI: 항목 변경 알림",
      "description": "리스트 항목 변경을 WorkHub AI 워커에 전달",
      "input_parameters": {
        "item_id": { "type": "string", "title": "항목 ID", "is_required": true },
        "list_id": { "type": "string", "title": "리스트 ID", "is_required": true },
        "event": { "type": "string", "title": "이벤트(updated/created)", "is_required": false }
      },
      "output_parameters": {
        "job_id": { "type": "string", "title": "워커 잡 ID" }
      }
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["function_executed", "message.channels"]
    },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "function_runtime": "remote"
  }
}
