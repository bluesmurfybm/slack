# slackai 워커 로컬 설정. 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다.
# 환경변수가 있으면 그쪽이 우선한다. 런타임 토글(paused/auto_plan/auto_review/post_to_slack/max_daily_usd/
# reviewer/sync_interval_sec/poll_interval_sec/budget_*)은 화면의 ai_settings 가 이 파일 값을 덮어쓴다.
#
# 운영 메모
#  - 시작: start_worker.bat (창 최소화 상주) 또는 install_task.ps1 (작업 스케줄러 ONLOGON, 현재 사용자로 실행)
#  - 워커는 저장소에서 유일하게 claude/codex/svn/git/php 를 실행하는 프로세스다. PHP 는 DB 만 읽고 쓴다.
#  - claude CLI 는 로그인 사용자의 OAuth 를 그대로 쓴다(--bare 금지). 서비스 계정이면 CLAUDE_CODE_OAUTH_TOKEN.
#  - 점검: python run_worker.py --selftest / 단건: --once --request Rec… --kind triage / 미리보기: --dry-run --kind plan --request Rec…

# ---- DB: 비우면 moodle/watch 처럼 `php -r` 로 ../../config.php 의 db 를 읽는다(이름만 SLACKAI_DB_NAME 으로 바꿈) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
SLACKAI_DB_NAME=slackai_db
# 포털 DB(school_access 가 있는 곳). 비우면 config.php 의 db.name(slack_db)
PORTAL_DB_NAME=
# 레포 자동 등록(discover_repos) 이 훑을 루트. 여러 개는 ; 로 구분. 각 루트 아래 *\03_Source\* 에서 .svn/.git 을 찾는다
REPO_SCAN_ROOTS=F:\project;G:\01_Bluesoft

# ---- 외부 실행 파일 ----
PHP_BIN=D:\wamp64\bin\php\php8.3.28\php.exe
CLAUDE_CLI=claude
CODEX_CLI=codex
GEMINI_CLI=
SVN_BIN=svn
GIT_BIN=git
NODE_BIN=node

# ---- Slack ----
# sync.php CLI / comments_cli / post_cli 용 토큰(개인 xoxp 또는 봇 xoxb). 비우면 ingest/유사 사례 댓글 조회가 건너뛴다.
SLACK_TOKEN=
# Socket Mode 이벤트 수신(기본 ON). 두 토큰이 비면 푸시는 "연결 안 됨" 으로 표시만 하고 워커는 계속 돈다.
SLACKAI_PUSH=1
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_PUSH_COMMENT_CHANNELS=C083TU7F0BZ,C08EEFB15EJ
SLACK_WEBHOOK_URL=
PORTAL_URL=http://dev.iworks.co.kr

# ---- LLM(싼 단계: 요약·태그·유사 재정렬·커밋 메시지·교훈) ----
# ANTHROPIC_API_KEY 가 비면 claude -p (--tools "" ) 로 대체한다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 1 이면 Claude CLI 서브프로세스에도 ANTHROPIC_API_KEY 를 넘긴다(구독 대신 API 과금). 기본 0 = 키를 제거해 OAuth 사용.
CLAUDE_USE_API_KEY=0
CLAUDE_CODE_OAUTH_TOKEN=
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_SMART=claude-sonnet-5
CLAUDE_PLAN_MODEL=claude-sonnet-5
CLAUDE_EXEC_MODEL=claude-sonnet-5
# 검토는 실행 모델과 다른 모델로
CLAUDE_REVIEW_MODEL=claude-opus-5
CLAUDE_FALLBACK_MODEL=
CODEX_MODEL=
OPENAI_MODEL=gpt-5
# {"model": {"in": USD/Mtok, "out": USD/Mtok}} 형식으로 단가표를 덧씌운다(비우면 내장 표)
LLM_PRICING_JSON=

# ---- 예산·타임아웃 ----
MAX_BUDGET_PLAN_USD=3
MAX_BUDGET_EXEC_USD=10
MAX_BUDGET_REVIEW_USD=2
MAX_DAILY_USD=30
CLAUDE_PLAN_TIMEOUT_SEC=1200
CLAUDE_EXEC_TIMEOUT_SEC=3600
CLAUDE_REVIEW_TIMEOUT_SEC=1200

# ---- 루프 ----
# 주기 폴링 없음(기본 0). 유실 대조를 원하면 1800 등. 기동 시 1회 증분 동기화는 항상 수행.
SYNC_INTERVAL_SEC=0
# ai_jobs 큐 확인 주기(초)
POLL_INTERVAL_SEC=3
WORKER_CONCURRENCY=1

# ---- 동작 토글 ----
SLACKAI_AUTO_PLAN=1
SLACKAI_AUTO_REVIEW=0
SLACKAI_POST_TO_SLACK=0
SLACKAI_UPDATE_BEFORE_EXEC=0
SLACKAI_GIT_PUSH=0
REVIEWER=codex,openai,gemini,claude
REPO_CONFIDENCE_MIN=0.75
SIMILAR_COMMENT_FETCH_MAX=8
# 1.01 = 자동 승인 없음(교훈은 사람이 승인)
LESSON_AUTO_APPROVE_WEIGHT=1.01
DISTILL_WEEKLY=0
# 런타임 데이터(로그·잡별 프롬프트 사본). 기본 slackai/worker/var
DATA_DIR=

# AI 가 조회·판단·수정·커밋하지 않는 환경별 설정 파일(저장소 루트 상대, ; 구분). 테스트/운영 서버마다 값이 다르다.
PROTECTED_PATHS=config.php;local/ubion/config.php
