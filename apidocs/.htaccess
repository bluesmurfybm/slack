# openapi.json 은 spec.php 가 로그인을 확인하고 내준다. 주소로 바로 받지 못하게 막는다.
# nginx 는 이 파일을 읽지 않는다 — server 블록에 `location = /apidocs/openapi.json { deny all; }` 가 있어야 한다.
<Files "openapi.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
