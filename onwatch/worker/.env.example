# onwatch/worker 로컬 설정. 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다.
# 환경변수가 있으면 그쪽이 우선한다. 서버는 systemd 유닛의 Environment= 로 준다.

# 엔진: auto(키가 있으면 API, 없으면 claude CLI) | anthropic | cli
ONWATCH_ENGINE=auto
# API 키. 비우면 서버/PC 에 로그인된 claude CLI 로 돈다(검색 횟수 상한·정확한 비용은 API 에서만).
ANTHROPIC_API_KEY=
ONWATCH_MODEL=claude-opus-5-5
ONWATCH_RESEARCH_EFFORT=high
ONWATCH_JUDGE_EFFORT=medium

# OnWatch 전체 한 달 비용 상한(USD). 감시별 상한과 별개로, 이것을 넘으면 모든 감시를 멈춘다.
ONWATCH_MONTHLY_BUDGET_USD=100
# 웹 검색 단가(1천 회당 USD) — 비용 계산용
WEB_SEARCH_USD_PER_1K=10

# 슬랙 기본 채널 웹훅. 감시마다 전용 웹훅을 줄 수도 있다(화면).
ONWATCH_SLACK_WEBHOOK_URL=
# 슬랙 메시지의 '자세히 보기' 링크 앞부분
PORTAL_URL=/

# php CLI(포털 알림 다리·DB 설정 읽기). PATH 에 없으면 전체 경로.
PHP_BIN=php

# DB — 비우면 포털 config.php 를 php CLI 로 읽는다
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
