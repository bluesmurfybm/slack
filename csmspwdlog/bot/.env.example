# csmspwdlog 봇 설정. 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다.
# 같은 이름의 환경변수가 있으면 그쪽이 우선한다.

# Slack 앱 토큰(Socket Mode, connections:write) — xapp-…
SLACK_APP_TOKEN=
# Slack 봇 토큰 — xoxb-…
SLACK_BOT_TOKEN=
# 주소를 받을 채널 ID. 여러 개면 쉼표로 구분 (예: C0123ABCD,C0456EFGH). 봇을 그 채널에 초대해야 한다.
CSMSPWDLOG_CHANNELS=
# php 실행 파일. PATH 에 있으면 php, 없으면 전체 경로
PHP_BIN=php
