<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="dti/tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         colors="true">
    <testsuites>
        <testsuite name="dti">
            <directory>dti/tests</directory>
        </testsuite>
        <testsuite name="schooltodo">
            <directory suffix="_test.php">schooltodo/tests</directory>
        </testsuite>
        <testsuite name="core">
            <directory suffix="_test.php">core/tests</directory>
        </testsuite>
        <testsuite name="bluecluster">
            <directory suffix="_test.php">bluecluster/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>dti/lib</directory>
            <directory>dti/routes</directory>
            <file>dti/db.php</file>
            <file>dti/guard.php</file>
            <directory>schooltodo/lib</directory>
            <directory>schooltodo/routes</directory>
            <file>schooltodo/db.php</file>
            <file>schooltodo/guard.php</file>
            <file>core/api_token.php</file>
            <file>core/crypto.php</file>
        </include>
    </source>
</phpunit>
