# moodle/watch 로컬 설정. 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다.
# 환경변수가 있으면 그쪽이 우선한다.

# moodle.org 모바일 WS 토큰 — login/token.php 응답의 "token" 값 (privatetoken 은 쓰지 않는다)
MOODLE_ORG_TOKEN=

# 요약: 비워 두면 서버/PC 의 claude CLI 로 요약한다. API 키를 쓰려면 채운다.
ANTHROPIC_API_KEY=

# 선택
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
PORTAL_URL=/
