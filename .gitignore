# OS / 편집기
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# 로그 / 임시
*.log
*.tmp
*.cache

# 세션 저장 폴더 (런타임 생성)
.sessions/

# 민감정보가 들어갈 수 있는 로컬 설정 (필요 시 config.local.php 로 분리)
config.php
config.local.php
sso_secret.key
vapid.key

# book(도서구매신청) 로컬 전용 설정/데이터
book/config_local.py
book/kakao_keys.json
book/book.db

# magazine(DTI 발표) 로컬 전용 설정/데이터
magazine/config_local.py
magazine/magazine.service
magazine/var/
magazine/**/*.db
magazine/*.db

# learning(강의 수강료 환급) 로컬 전용 설정/데이터
learning/config_local.py
learning/learning.service
learning/var/
learning/**/*.db
learning/*.db

# learn(BlueLearn) 이수증 원본 — 업로드본이라 저장소에 올리지 않는다.
# 폴더는 learn/var/.htaccess(직접 접근 차단)와 함께 앱이 만든다.
learn/var/uploads/

# composer (dti 모듈 오토로드·테스트)
/vendor/
/.phpunit.cache/

# dti(DTI 발표) 업로드 원본·런타임 데이터
dti/var/

# 파이썬 캐시/가상환경 (저장소 전체)
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/

# slack 첨부파일 디스크 캐시 — file.php 가 슬랙 URL 해시로 저장한다.
# 지워도 다음 조회 때 다시 받는다. 계속 쌓이므로 저장소에 올리지 않는다.
slack/.filecache/
slackai/.filecache/

# slackai(WorkHub AI) 워커 — 토큰·런타임 데이터는 올리지 않는다. knowledge/*.md 는 학습 산출물이라 공유한다(아래 *.md 예외).
slackai/worker/.env
slackai/worker/var/

# 로컬 작업관련 문서 (book/ 등 하위 폴더 포함, 모든 md 문서)
_info
*.md
blueup_learning_summary.txt
# 단, 루트 readme.md는 다른 개발자를 위한 프로젝트 현황 문서라 공유되어야 함
!/readme.md
# dti/README.md는 서버에 올리는 사람이 봐야 하는 설치·운영 문서라 공유되어야 함
!/dti/README.md
# studio/README.md도 같은 이유로 공유되어야 함 (배포 절차·마이그레이션 순서·환경별 설정)
!/studio/README.md
# onwatch/README.md 도 같은 이유(배포 절차·systemd·환경변수)
!/onwatch/README.md
# slackai 워커가 레포별로 증류한 학습 지식 문서 — 플랜 프롬프트에 들어가므로 공유되어야 함
!/slackai/worker/knowledge/*.md
# 공지 첨부 원본. 폴더는 var/.htaccess(직접 접근 차단)와 함께 앱이 만든다.
var/notice/

# blueledger(BlueLedger 출장여비) 영수증 원본. 폴더는 blueledger/var/.htaccess(직접 접근 차단)와 함께 앱이 만든다.
blueledger/var/receipts/
blueledger/var/resort/
# blueledger/README.md 는 서버에 올리는 사람이 봐야 하는 설치·운영 문서라 공유되어야 함
!/blueledger/README.md
# 리조트 예약(BlueStay)은 아직 올리지 않는다 — 이 PC 의 bluestay 브랜치에만 있다(2026-10-22).
# amitoa 에서 실수로 다시 커밋되지 않게 막아 둔다. bluestay 브랜치의 파일은 이미 추적 중이라 영향 없다.
blueledger/resort/
# 로컬 시험(SQLite, dev/local_setup.php) 데이터 — PC 마다 다르다
var/localdb/
# sitehub 초기 데이터 엑셀 — 전 고객사 계정이 들어 있어 커밋 금지 (레포 루트에 두고 화면/CLI 로 가져온다)
/호스팅 정보*.xlsx
# sitehub 변환 도구의 Slack 원본 백업 (tools/move_request_time.php)
/var/sitehub/
