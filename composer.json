{
    "name": "bluesoft/blue-iworks",
    "description": "blue-iWorks 포털 — dti 모듈 오토로드와 테스트",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Dti\\": "dti/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dti\\Tests\\": "dti/tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
